# Arc escrow workspace. Copy to .env (gitignored) or, better, keep these in Pier.
# Never a mainnet key in this file, in this repo, or in this environment.

# Networks (public URLs, from docs.arc.io). Testnet chain id 5042002, mainnet 5042.
ARC_TESTNET_RPC_URL=https://rpc.testnet.arc.io
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io

# Which network the CLI talks to: testnet (default) or mainnet. Mainnet is config only in
# phase 3; the CLI refuses it unless ARC_MAINNET_CONFIRM=I_UNDERSTAND is also set.
ARC_NETWORK=testnet

# Roles. Three distinct keys. The owner sets roles, tiers, caps and the pause switch and
# can withdraw the free pool; the operator opens and settles rounds; the signer signs
# settlements and holds no funds. A compromised signer alone cannot settle (the operator
# submits) nor drain (caps in the contract).
OWNER_KEY=0x
OPERATOR_KEY=0x
SIGNER_KEY=0x
# A player for the CLI cycle. Fund it from https://faucet.circle.com on testnet.
PLAYER_KEY=0x

# Set after deploy (cli/deploy prints it).
ESCROW_ADDRESS=

# Tier table for deploy, USDC in 6 decimal units. Entry 0.50 USDC; 1st 1.20, 2nd 0.70,
# 3rd 0.40. Caps: 2.30 per round, 20.00 per player per window. The window is in blocks
# (Arc timestamps only never decrease); testnet mines a block every 0.5 s, so 172800 is a day.
ENTRY_AMOUNT=500000
TIERS=1200000,700000,400000
MAX_PAYOUT_PER_ROUND=2300000
MAX_PAYOUT_PER_PLAYER_PER_WINDOW=20000000
WINDOW_BLOCKS=172800
