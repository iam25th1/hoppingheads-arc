# Hopping Heads Arc server. Copy nothing: set these in Pier (or your host),
# never in a committed file.

# Port the server listens on. Under Pier this must match "port" in pier.json.
PORT=7510
NODE_ENV=development

# PostgreSQL. The schema is created on boot from server/src/db/schema.sql.
DATABASE_URL=postgresql://user:pass@host:5432/hoppingheads_arc

# Signs wallet session tokens. Without it sign in answers 503 and no lobby is
# joinable. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Origins allowed for HTTP and socket connections, comma separated. The game
# is same origin, but socket.io checks the Origin header, so the URL the
# browser loads the game from must be listed.
ALLOWED_ORIGINS=http://hh-arc.test:7080,http://localhost:7510

# The chain the Arena settles on. Testnet is 5042002. The server reads the escrow over
# ARC_RPC_URL (public, no key) to learn who staked and what is claimable; it never sends
# a transaction. Without ESCROW_ADDRESS the Arena is offline and says so; Quick Play
# never touches the chain either way. The operator and signer keys live with their own
# services (services/settler, services/signer), never here.
CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
EXPLORER_URL=https://explorer.testnet.arc.io
ESCROW_ADDRESS=
