# hh-arc-signer. Its own Pier service, its own env block. Never in a committed file.
# The only key this process holds. It signs the EIP-712 Settlement struct and nothing else.
SIGNER_KEY=0x
# Shared with the settlement worker (SIGNER_TOKEN there too). At least 32 characters:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SIGNER_TOKEN=
# The domain the signature is bound to: Arc testnet and the deployed escrow.
CHAIN_ID=5042002
ESCROW_ADDRESS=0xF50e5b345293B027046400Ae0d9D02F7b67bD72B
# Loopback only. The worker runs on the same host.
PORT=7520
BIND=127.0.0.1
