# hh-arc-settler. Its own Pier service, its own env block. Never in a committed file.
# The operator key: opens rounds and submits settlements. No other key lives here.
OPERATOR_KEY=0x
# Arc testnet and the deployed escrow. Mainnet (5042) is refused without ARC_MAINNET_CONFIRM.
CHAIN_ID=5042002
ARC_RPC_URL=https://rpc.testnet.arc.io
ESCROW_ADDRESS=0xF50e5b345293B027046400Ae0d9D02F7b67bD72B
# The game database this worker reads rounds from and writes settlements to.
DATABASE_URL=postgresql://user:pass@host:5432/hoppingheads_arc
# The signer service, loopback, and the token it shares with us.
SIGNER_URL=http://127.0.0.1:7520
SIGNER_TOKEN=
# Tuning. A receipt deadline of 90 s at 0.5 s blocks; three attempts, then stalled.
POLL_MS=3000
RECEIPT_DEADLINE_MS=90000
MAX_ATTEMPTS=3
# Stamp settlements through the Memo predeploy (1) or call the escrow directly (0).
SETTLE_VIA_MEMO=1
